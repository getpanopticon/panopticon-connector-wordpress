#
# Panopticon Connector for WordPress E2E harness settings. run.sh copies this file to .env (git-ignored) on the first
# run; edit .env, not this.
#
# The WordPress and PHP versions under test are NOT configured here: they come from matrix.env, which is committed and
# which run.sh sources after .env. Use run.sh --wp / --php for a one-off pair.
#

# --- Stack -----------------------------------------------------------------------------------------------------------
APACHE_VERSION=2.4
MYSQL_VERSION=8.4
# 8230/33323 are not used by any other Akeeba E2E stack.
HTTP_PORT=8230
DB_PORT=33323
DB_NAME=integration
DB_USER=integration
DB_PASSWORD=integration
DB_ROOT_PASSWORD=root
DB_PREFIX=wp_

# --- Site ------------------------------------------------------------------------------------------------------------
SITE_TITLE="Panopticon Connector E2E"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test
ADMIN_EMAIL=test@example.com
