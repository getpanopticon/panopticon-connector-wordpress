#
# The WordPress/PHP environments the E2E suite runs against. Sourced by run.sh AFTER the git-ignored .env, so that this
# committed file wins and every checkout tests the same thing. Do not set these in .env; use run.sh --wp / --php to
# change what a single run tests. See ../README.md, "Why these versions", before changing them.
#
# WP_MATRIX is a space-separated list of `wordpress:php` pairs, oldest first. The WordPress side may be a full version
# (7.0.8) or a branch (7.0); a branch resolves to its latest release (buildfiles' getcms does that).
#
#   1. WordPress 7.0 on PHP 7.4 - the previous WordPress branch, on the oldest PHP it and the shared images support.
#   2. WordPress 7.1 on PHP 8.5 - the latest WordPress branch, on the newest stable PHP.
WP_MATRIX="7.0:7.4 7.1:8.5"

# What a plain `run.sh` (no --matrix) runs: the newest of each, i.e. the last matrix entry.
WP_VERSION=7.1
PHP_VERSION=8.5
