<!--
    The E2E suite: plain HTTP clients driving a real WordPress + Connector install running in Docker. No WordPress is
    booted in-process. Run it through tests/integration/docker/run.sh, which provisions the site and generates
    tests/integration/config.php; see tests/integration/README.md.
-->
<phpunit bootstrap="tests/integration/bootstrap-e2e.php" colors="true" cacheResult="false">
	<testsuites>
		<testsuite name="integration">
			<directory>tests/integration/src/Tests</directory>
		</testsuite>
	</testsuites>
</phpunit>
